<Project Sdk="Microsoft.NET.Sdk">

  <!-- Agente de impresión del local: pide a la API los trabajos de su sucursal y los manda a las impresoras.
       Se publica autocontenido (no hace falta instalar .NET) con agent/empaquetar.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FocoAgente</AssemblyName>
    <RootNamespace>FocoAgente</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- Los atributos de validación del modelo compartido no se usan en el agente. -->
    <NoWarn>$(NoWarn);IL2026</NoWarn>
  </PropertyGroup>

  <!-- Mismo envío a impresoras que usa la API. -->
  <ItemGroup>
    <Compile Include="../../src/Services/PrinterTransport.cs" Link="Shared/PrinterTransport.cs" />
    <Compile Include="../../src/Services/WindowsRawPrinter.cs" Link="Shared/WindowsRawPrinter.cs" />
    <Compile Include="../../src/Models/PrinterConfiguration.cs" Link="Shared/PrinterConfiguration.cs" />
  </ItemGroup>

</Project>
