// Publicación de app.focobr.net (Cloudflare Workers): landing en "/", sistema en
// "/ingresar" y acceso de sistemas en "/sistemas". Publicar con ./deploy_web.sh
{
  "name": "foco-app",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "build/web",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "app.focobr.net", "custom_domain": true }]
}
